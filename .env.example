# ===============================
# AMBIENTE GERAL
# ===============================
NODE_ENV=production
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
DEFAULT_TIMEZONE=America/Sao_Paulo
COLLECTION_START_HOUR=8
COLLECTION_END_HOUR=20
MAX_ATTEMPTS_DAY=3
MAX_ATTEMPTS_WEEK=7

# ===============================
# SUPABASE / POSTGRES REST
# ===============================
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=COLE_AQUI_ANON_KEY

# ===============================
# OPENAI
# ===============================
OPENAI_API_KEY=COLE_AQUI_OPENAI_KEY
OPENAI_MODEL=gpt-4.1-mini

# ===============================
# WHATSAPP / EVOLUTION API
# ===============================
EVOLUTION_BASE_URL=https://sua-evolution-api.com
EVOLUTION_INSTANCE=sua-instancia
EVOLUTION_API_KEY=sua-chave

# ===============================
# EMAIL TRANSACIONAL
# Exemplo genérico: Resend, SendGrid, Brevo, Mailgun ou endpoint próprio.
# ===============================
MAILER_API_URL=https://api.seuprovedor.com/send
MAILER_API_KEY=sua-chave-email
MAIL_FROM_NAME=Assessoria de Cobrança
MAIL_FROM_EMAIL=cobranca@suaempresa.com.br

# ===============================
# VOZ / LIGAÇÃO
# Endpoint genérico para criar ligação ou tarefa de call center.
# ===============================
VOICE_API_URL=https://api.seuprovedorvoz.com
VOICE_API_KEY=sua-chave-voz
CALLER_ID=+554700000000

# ===============================
# NOTIFICAÇÃO HUMANA / CRM
# Pode ser Slack, Discord, CRM próprio, webhook interno ou fila.
# ===============================
HUMAN_HANDOFF_WEBHOOK=https://seu-crm.com/webhook/handoff-cobranca
HUMAN_HANDOFF_TOKEN=sua-chave-handoff
