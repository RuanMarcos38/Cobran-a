{
  "name": "Cobran-a | Prospeccao comercial 24x7 (15 min)",
  "nodes": [
    {
      "id": "cobranca-trigger",
      "name": "A cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "cobranca-dispatch",
      "name": "Prospeccao - ciclo seguro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.COBRANCA_PROSPECTION_URL}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Integration-Key",
              "value": "={{$env.COBRANCA_PROSPECTION_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"operation\":\"dispatch\"}",
        "options": {
          "timeout": 90000
        }
      }
    }
  ],
  "connections": {
    "A cada 15 minutos": {
      "main": [
        [
          {
            "node": "Prospeccao - ciclo seguro",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "America/Sao_Paulo",
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}